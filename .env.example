# 솔라링크 (Solarlink) 환경변수 예시 설정 템플릿 (.env.example)

# [프론트엔드/클라이언트 노출용]
# 사이트의 메인 배포 절대 URL (예: https://www.solarlink.co.kr)
NEXT_PUBLIC_SITE_URL=https://www.solarlink.co.kr

# [백엔드/서버 전용 - 민감 정보 포함 (클라이언트에 노출하지 마세요)]
# 폼 제출 접수 시 리드 데이터를 수신할 외부 웹훅 URL (Slack, Discord, 또는 커스텀 CRM API)
LEAD_WEBHOOK_URL=

# 리드 알림을 수신할 마스터 운영자 이메일 주소
LEAD_EMAIL_TO=

# 이메일 발송 서버의 발신자 메일 주소
LEAD_EMAIL_FROM=

# SMTP 발송 서버 계정 설정 (Gmail, Naver 등 메일 송신 연동용)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
